LIBRARY         RSRC16
DESCRIPTION     'Resource Meter thunks'
EXETYPE         WINDOWS
CODE            MOVEABLE DISCARDABLE PRELOAD
DATA            MOVEABLE SINGLE PRELOAD
HEAPSIZE        5120

IMPORTS
    THUNKCONNECT16 = KERNEL.651
    __WINFLAGS     = KERNEL.178

EXPORTS
    THK_THUNKDATA16             @1  RESIDENTNAME
    DLLENTRYPOINT               @2  RESIDENTNAME
    MYGETFREESYSTEMRESOURCES16  @3  RESIDENTNAME
    WEP                         @4  RESIDENTNAME
