LIBRARY         MSMIXMGR
DESCRIPTION     'Microsoft Audio Mixer Manager'
EXETYPE         WINDOWS
PROTMODE
CODE            MOVEABLE DISCARDABLE PRELOAD
DATA            MOVEABLE SINGLE DISCARDABLE

IMPORTS
    MMSYS_MIXERGETNUMDEVS        = MMSYSTEM.800
    MMSYS_MIXERGETDEVCAPS        = MMSYSTEM.801
    MMSYS_MIXEROPEN              = MMSYSTEM.802
    MMSYS_MIXERCLOSE             = MMSYSTEM.803
    MMSYS_MIXERMESSAGE           = MMSYSTEM.804
    MMSYS_MIXERGETLINEINFO       = MMSYSTEM.805
    MMSYS_MIXERGETID             = MMSYSTEM.806
    MMSYS_MIXERGETLINECONTROLS   = MMSYSTEM.807
    MMSYS_MIXERGETCONTROLDETAILS = MMSYSTEM.808
    MMSYS_MIXERSETCONTROLDETAILS = MMSYSTEM.809

EXPORTS
    WEP                     @1  RESIDENTNAME
    MIXERGETID              @12
    MIXERGETLINEINFO        @16
    MIXERCLOSE              @14
    MIXERGETNUMDEVS         @10
    MIXERGETLINECONTROLS    @17
    MIXERGETDEVCAPS         @11
    MIXEROPEN               @13
    MIXERMESSAGE            @15
    MIXERGETCONTROLDETAILS  @18
    MIXERSETCONTROLDETAILS  @19
