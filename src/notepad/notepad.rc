/*
 * notepad.rc - Notepad resources (generated from the original with tools/res2rc.py,
 * then kept as source).  Icons are extracted from the original at build time.
 */

1 ICON icon1.ico

2 ICON icon2.ico

1 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", 9
        MENUITEM "&Open...", 10
        MENUITEM "&Save", 1
        MENUITEM "Save &As...", 2
        MENUITEM SEPARATOR
        MENUITEM "Page Se&tup...", 32
        MENUITEM "&Print", 14
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 28
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", 25
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", 768, GRAYED
        MENUITEM "&Copy\tCtrl+C", 769, GRAYED
        MENUITEM "&Paste\tCtrl+V", 770, GRAYED
        MENUITEM "De&lete\tDel", 771, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Select &All", 7
        MENUITEM "Time/&Date\tF5", 12
        MENUITEM SEPARATOR
        MENUITEM "&Word Wrap", 27
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "&Find...", 3
        MENUITEM "Find &Next\tF3", 8
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics", 5
        MENUITEM SEPARATOR
        MENUITEM "&About Notepad", 11
    END
END

