12 DIALOG DISCARDABLE 20, 20, 90, 64
STYLE 0x90c800c0
CAPTION "Notepad"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "Cancel", 2, "Button", 0x50030001, 29, 44, 32, 14
    CONTROL "Now Printing", -1, "Static", 0x50020001, 0, 8, 90, 8
    CONTROL "", 20, "Static", 0x50020081, 0, 18, 90, 8
END

14 DIALOG DISCARDABLE 0, 0, 356, 196
STYLE 0x90c820c4
CAPTION "Page Setup"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "Paper", 1073, "Button", 0x50020007, 8, 8, 224, 56
    CONTROL "Si&ze:", 1089, "Static", 0x50020000, 16, 24, 36, 8
    CONTROL "", 1137, "ComboBox", 0x50230103, 64, 23, 160, 160
    CONTROL "&Source:", 1090, "Static", 0x50020000, 16, 45, 36, 8
    CONTROL "", 1138, "ComboBox", 0x50230103, 64, 42, 160, 160
    CONTROL "Orientation", 1072, "Button", 0x50020007, 8, 69, 64, 56
    CONTROL "P&ortrait", 1056, "Button", 0x50030009, 16, 82, 52, 12
    CONTROL "L&andscape", 1057, "Button", 0x50000009, 16, 103, 52, 12
    CONTROL "Margins", 1075, "Button", 0x50020007, 80, 69, 152, 56
    CONTROL "&Left:", 1102, "Static", 0x50020000, 88, 85, 32, 8
    CONTROL "", 1155, "Edit", 0x50830000, 120, 82, 28, 12
    CONTROL "&Right:", 1103, "Static", 0x50020000, 164, 85, 32, 8
    CONTROL "", 1157, "Edit", 0x50830000, 196, 82, 28, 12
    CONTROL "&Top:", 1104, "Static", 0x50020000, 88, 104, 32, 8
    CONTROL "", 1156, "Edit", 0x50830000, 120, 103, 28, 12
    CONTROL "&Bottom:", 1105, "Static", 0x50020000, 164, 104, 32, 8
    CONTROL "", 1158, "Edit", 0x50830000, 196, 103, 28, 12
    CONTROL "&Header:", 32, "Static", 0x50020000, 8, 135, 29, 8
    CONTROL "", 30, "Edit", 0x50810080, 56, 134, 174, 12
    CONTROL "&Footer:", 33, "Static", 0x50020000, 8, 154, 29, 8
    CONTROL "", 31, "Edit", 0x50810080, 56, 153, 174, 12
    CONTROL "OK", 1, "Button", 0x50030001, 190, 174, 50, 14
    CONTROL "Cancel", 2, "Button", 0x50010000, 244, 174, 50, 14
    CONTROL "&Printer...", 1026, "Button", 0x50010000, 298, 174, 50, 14
    CONTROL "Preview", 34, "Button", 0x50000007, 240, 8, 108, 158
    CONTROL "", 1080, "Static", 0x50000006, 254, 46, 80, 80
