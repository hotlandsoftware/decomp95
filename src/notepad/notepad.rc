1 VERSIONINFO
FILEVERSION     4,0,0,950
PRODUCTVERSION  4,0,0,950
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x10001L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation\0"
            VALUE "FileDescription", "Windows Notepad application file\0"
            VALUE "FileVersion", "4.00.950\0"
            VALUE "InternalName", "Notepad\0"
            VALUE "LegalCopyright", "Copyright © Microsoft Corp. 1991-1995\0"
            VALUE "OriginalFilename", "NOTEPAD.EXE\0"
            VALUE "ProductName", "Microsoft® Windows® Operating System\0"
            VALUE "ProductVersion", "4.00.950\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4e4
    END
END

STRINGTABLE
BEGIN
    48, "You cannot quit Windows because the Save As dialog\nbox in Notepad is open. Switch to Notepad, close this\ndialog box, and then try quitting Windows again."
    50, "Cannot load the driver for your printer.\nThere may not be enough memory, or the printer-driver file is missing.  \n\nReinstall your printer, or quit one or more applications to increase available memory, and then try again."
    51, "%%\nYou do not have permission to open this file.  See the owner of the file or an administrator to obtain permission."
    52, "This file is too large for Notepad to open.\nWould you like to use WordPad to read this file?"
    53, "There was a failure in launching WordPad."
    55, "/p "
    56, "wordpad.exe"
    57, "Courier New"
END

STRINGTABLE
BEGIN
    32, "%%"
    33, "\\*.txt"
    34, "notepad.hlp"
    36, "&f"
    37, "Page &p"
    42, "fFpPtTdDcCrRlL"
    43, "Cannot open the %% file.\n\nCannot print the file because it can't be found or is currently being used by another application. Be sure that the path and filename are correct, or wait until the application is finished, and then t \nry again."
    44, "Text Documents"
    45, "All Files (*.*)"
END

STRINGTABLE
BEGIN
    1, "Cannot open the %% file.\n\nMake sure a disk is in the drive you specified."
    3, "Cannot find the %% file.\n\nDo you want to create a new file?"
    5, "The %% file already exists.\n\nDo you want to overwrite it?"
    10, "The text in the %% file has changed.\n\nDo you want to save the changes?"
    11, "Untitled"
    12, " - Notepad"
END

STRINGTABLE
BEGIN
    16, "Cannot find ""%%"""
    17, "Not enough memory available to complete this operation. Quit one or more applications to increase available memory, and then try again."
    18, "The %% file is too large for Notepad.\n\nUse another editor to edit the file."
    19, "Notepad"
    20, "The Clipboard line is too long to paste.\n\nCopy and paste smaller portions of the line."
    21, "Not enough disk space to save the %% file.\n\nDelete one or more files to increase available disk space, or save the file to a different disk."
    22, "The %% file is not in the correct format for use with Notepad.\n\nCreate a new file or try opening a different file."
    25, "Cannot print the %% file. Be sure that your printer is connected properly and use Control Panel to verify that the printer is configured properly."
    26, "Not a valid file name."
    27, "The filename %% is not valid.\nerify that the filename is no longer than 8 characters, followed by a period and an extension."
    28, "Not enough disk space to print the %% file.\nDelete one or more files to increase available disk space, and then try again."
    29, "Not enough memory to print.\n\nQuit one or more applications to increase available memory, and then try again."
    30, "Cannot create the %% file.\n\nMake sure that the path and filename are correct."
    31, "Cannot carry out the Word Wrap command because there is too much text in the file."
END
